{
    "rewrites": [
        {
            "source": "/auth/:path*",
            "destination": "http://nile.hidencloud.com:24605/auth/:path*"
        },
        {
            "source": "/api/:path*",
            "destination": "http://nile.hidencloud.com:24605/api/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}